{
	"name": "ufobeer",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"test:unit": "vitest --config vitest.unit.config.mts",
		"test:contract": "GOLDEN_CONTRACT=1 vitest --run",
		"typecheck": "tsc --noEmit",
		"typecheck:test": "tsc --project test/tsconfig.json --noEmit",
		"typecheck:contract": "tsc --project contract-test/tsconfig.json --noEmit",
		"migrate:remote": "wrangler d1 migrations apply beer-db --remote",
		"migrate:local": "wrangler d1 migrations apply beer-db --local",
		"migrate:list": "wrangler d1 migrations list beer-db --remote",
		"cf-typegen": "wrangler types",
		"spelling:candidates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/find-spelling-candidates.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.4",
		"typescript": "^7.0.2",
		"vitest": "~5.0.3",
		"wrangler": "^4.149.0"
	},
	"dependencies": {
		"zod": "^4.6.6"
	}
}
