{
	"name": "ufobeer-error-alerts",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	// Recipient for error alert emails; src/index.ts reads env.TO_ADDRESS.
	// Must match send_email.destination_address below.
	"vars": {
		"TO_ADDRESS": "alerts-to@ufobeer.app"
	},
	// Tail consumers receive no HTTP traffic; keep the *.workers.dev URL off.
	"workers_dev": false,
	// Durable alert cooldown store, also backing the total-volume email cap
	// (src/cooldown.ts, src/emailCap.ts). Tail Workers run per-isolate and
	// per-location, so an in-memory cooldown only holds within one warm
	// isolate; KV makes it hold across all of them. Both modules degrade to
	// an in-isolate fallback (not full suppression) if this store is down.
	//
	// Namespace "ufobeer-error-alerts-cooldown", provisioned 2026-09-01.
	"kv_namespaces": [
		{
			"binding": "COOLDOWN_KV",
			"id": "17b1265c5e704ff883700aceed8a8808"
		}
	],
	"send_email": [
		{
			"name": "SEND_EMAIL",
			"destination_address": "alerts-to@ufobeer.app"
		}
	]
}