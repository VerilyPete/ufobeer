{
  "__inputs": [
    {
      "name": "DS_UFOBEER",
      "label": "ufobeer usage reports",
      "description": "Infinity data source with base URL https://api.ufobeer.app/reports/usage",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "title": "BeerSelector usage",
  "uid": "beerselector-usage",
  "tags": [
    "beerselector",
    "usage"
  ],
  "timezone": "utc",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "schemaVersion": 39,
  "editable": true,
  "description": "Beta usage telemetry from GET /reports/usage. Days are UTC receipt days. Counts are unverified: good for trends and ratios, not exact figures.",
  "panels": [
    {
      "id": 1,
      "title": "Active installs and sessions",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_UFOBEER}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_UFOBEER}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "",
          "root_selector": "",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "view",
                "value": "daily"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "day",
              "text": "Day",
              "type": "timestamp"
            },
            {
              "selector": "active_installs",
              "text": "Active installs",
              "type": "number"
            },
            {
              "selector": "new_installs",
              "text": "New installs",
              "type": "number"
            },
            {
              "selector": "sessions",
              "text": "Sessions",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Events per day",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_UFOBEER}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_UFOBEER}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "",
          "root_selector": "",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "view",
                "value": "events"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "day",
              "text": "Day",
              "type": "timestamp"
            },
            {
              "selector": "event",
              "text": "Event",
              "type": "string"
            },
            {
              "selector": "count",
              "text": "Count",
              "type": "number"
            }
          ]
        }
      ],
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "Event"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": false
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Feature adoption",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_UFOBEER}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_UFOBEER}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "",
          "root_selector": "",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "view",
                "value": "adoption"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "event",
              "text": "Event",
              "type": "string"
            },
            {
              "selector": "installs_using",
              "text": "Installs using",
              "type": "number"
            },
            {
              "selector": "active_installs",
              "text": "Active installs",
              "type": "number"
            },
            {
              "selector": "share",
              "text": "Share of installs",
              "type": "number"
            },
            {
              "selector": "avg_per_session",
              "text": "Uses per session",
              "type": "number"
            }
          ]
        }
      ],
      "description": "Over the whole time range. Share is installs using the event out of all active installs. Uses per session divides the event count by the sessions of only the installs that used it; empty when they reported no sessions.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Share of installs"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uses per session"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "noValue",
                "value": "—"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Installs using",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Event": 0,
              "Installs using": 1,
              "Active installs": 2,
              "Share of installs": 3,
              "Uses per session": 4
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "App versions",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_UFOBEER}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_UFOBEER}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "",
          "root_selector": "$[dimension=\"app_version\"]",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "view",
                "value": "breakdown"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "day",
              "text": "Day",
              "type": "timestamp"
            },
            {
              "selector": "value",
              "text": "Value",
              "type": "string"
            },
            {
              "selector": "active_installs",
              "text": "Installs",
              "type": "number"
            }
          ]
        }
      ],
      "description": "Distinct installs per day for each value. An install that changed value during a day counts under each, so a day can add up to more than its active installs.",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "Value"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": false
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Apple Intelligence status",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_UFOBEER}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_UFOBEER}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "",
          "root_selector": "$[dimension=\"ai_status\"]",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "view",
                "value": "breakdown"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "day",
              "text": "Day",
              "type": "timestamp"
            },
            {
              "selector": "value",
              "text": "Value",
              "type": "string"
            },
            {
              "selector": "active_installs",
              "text": "Installs",
              "type": "number"
            }
          ]
        }
      ],
      "description": "Distinct installs per day for each value. An install that changed value during a day counts under each, so a day can add up to more than its active installs.",
      "transformations": [
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "Value"
            ],
            "keepFields": false,
            "naming": {
              "asLabels": false
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 30,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Reports received and dropped",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_UFOBEER}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_UFOBEER}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "",
          "root_selector": "",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "view",
                "value": "daily"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "day",
              "text": "Day",
              "type": "timestamp"
            },
            {
              "selector": "posts",
              "text": "Reports stored",
              "type": "number"
            },
            {
              "selector": "duplicates",
              "text": "Duplicates",
              "type": "number"
            },
            {
              "selector": "dropped_post_cap",
              "text": "Dropped: post cap",
              "type": "number"
            },
            {
              "selector": "dropped_new_install",
              "text": "Dropped: new-install cap",
              "type": "number"
            },
            {
              "selector": "dropped_all_events",
              "text": "Dropped: no known event",
              "type": "number"
            }
          ]
        }
      ],
      "description": "Counts reports (posts). Before 2026-11-10 (reports) and 2026-11-12 (drops) the server did not count these, so those days show no data rather than 0. A drop counter stops at 10,000 a day.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "none",
          "decimals": 0,
          "noValue": "no data"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Event entries dropped",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "${DS_UFOBEER}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "${DS_UFOBEER}"
          },
          "type": "json",
          "source": "url",
          "parser": "backend",
          "format": "table",
          "url": "",
          "root_selector": "",
          "url_options": {
            "method": "GET",
            "data": "",
            "params": [
              {
                "key": "view",
                "value": "daily"
              },
              {
                "key": "from",
                "value": "${__from}"
              },
              {
                "key": "to",
                "value": "${__to}"
              }
            ]
          },
          "columns": [
            {
              "selector": "day",
              "text": "Day",
              "type": "timestamp"
            },
            {
              "selector": "dropped_events",
              "text": "Event entries dropped",
              "type": "number"
            }
          ]
        }
      ],
      "description": "Counts event entries, not reports: entries the server did not recognise in reports whose other events were stored. Usually an app build sending an event this server does not know yet. No data before 2026-11-12.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "always",
            "pointSize": 6,
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "none",
          "decimals": 0,
          "noValue": "no data"
        },
        "overrides": []
      }
    }
  ]
}
